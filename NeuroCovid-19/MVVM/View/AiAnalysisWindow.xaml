<Window x:Class="NeuroCovid19.MVVM.View.AiAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        mc:Ignorable="d"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5"
        Icon="/Resources/icon.png">
    <Window.Resources>
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FF3399FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF3399FF" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="🤖"
                           FontSize="24"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Характеристика от ИИ"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock x:Name="SubtitleText"
                               Text="Анализ кластера нейросетью DeepSeek"
                               FontSize="12"
                               Foreground="#E0E0E0"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Markdown Content -->
        <Border Grid.Row="1" Background="White" Margin="12,12,12,0" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
            <FlowDocumentScrollViewer x:Name="MarkdownViewer"
                                      IsToolBarVisible="False"
                                      Margin="10"/>
        </Border>

        <!-- Bottom Bar -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="12,8" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           Text="Готово"
                           VerticalAlignment="Center"
                           Foreground="#666666"
                           FontSize="12"/>

                <Button Grid.Column="1"
                        Style="{StaticResource WindowButtonStyle}"
                        Background="#FF3399FF"
                        Click="CopyButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource WindowButtonStyle}"
                        Background="#666666"
                        Click="CloseButton_Click"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Закрыть"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>